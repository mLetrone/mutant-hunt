# pnpm 11. Keep the install reproducible and the version pins meaningful.
engine-strict=true
# Exact versions on `pnpm add` - a caret on vitest is how this repo goes green at 0%.
save-exact=true
# Stryker's vitest-runner resolves `vitest` from the project root; a strictly
# isolated store is fine, but hoisting nothing at all makes that resolution brittle.
# Default (isolated) node_modules is kept; this only widens peer resolution noise.
strict-peer-dependencies=false
